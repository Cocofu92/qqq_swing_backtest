# Data cache (keep dir via .gitkeep)
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.venv/
venv/
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# IG bars and search artefacts (overrides any data/ ignore above)
!data/ig/
!data/ig/**
!data/ig/.gitkeep

